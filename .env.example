# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where AssetVault IT is hosted (e.g. https://assetvault.example.com).
# Used for Paystack callbacks, GitHub OAuth callbacks, and invite links.
APP_URL="http://localhost:3000"

# MONGODB_URI: MongoDB Atlas connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority)
# When omitted, AssetVault IT uses local persistent SQLite storage in ./data/.
MONGODB_URI=""

# MONGODB_DB_NAME: Optional MongoDB database name (defaults to assetvault_it)
MONGODB_DB_NAME="assetvault_it"

# SESSION_SECRET: Secret key used to sign authentication session tokens (min 32 chars in production)
SESSION_SECRET=""

# GITHUB_CLIENT_ID & GITHUB_CLIENT_SECRET: GitHub OAuth App credentials
# Callback URL in GitHub OAuth App settings: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# PAYSTACK_SECRET_KEY & PAYSTACK_PUBLIC_KEY: Paystack GH₵ billing keys
# When omitted, Paystack runs in explicit test_simulation checkout mode.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS: Outbound transactional email settings
# When omitted, password reset & invitation tokens are surfaced in-app for testing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# CRON_SECRET: Shared secret header (X-Cron-Secret) for Cloud Scheduler / external cron triggers on POST /api/jobs/run
CRON_SECRET=""

# SUPER_ADMIN_INITIAL_PASSWORD: Initial bootstrap password for platform super admin (georgearthur848@gmail.com)
SUPER_ADMIN_INITIAL_PASSWORD=""
